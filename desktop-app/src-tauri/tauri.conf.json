{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pali Sinhala Dictionary",
  "version": "1.0.0",
  "identifier": "io.github.pali-sinhala-dictionary.dpsd",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "පාලි-සිංහල ශබ්දකෝෂය | Pali-Sinhala Dictionary",
        "width": 900,
        "height": 900,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Pali-Sinhala Dictionary",
    "copyright": "Pali-Sinhala Dictionary — pali-sinhala-dictionary.github.io/DPSD",
    "category": "Education",
    "shortDescription": "Pali-Sinhala Dictionary — පාලි-සිංහල ශබ්දකෝෂය",
    "longDescription": "Offline Pali-Sinhala and Sinhala-English dictionary with inflection tables.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
